# sent_id = medical-0002-00010002
# text = Նշանքն այս է, որ է ֆընտու, հեվայ գրաստն խիստ և լարի պինչքն, ու թուլնա գլուխն և ամէն զաւդվածքն, և փայտնայ ոտվին, և կտրի ի կերոյ, և ի սկիզբն այս ցաւուս՝ ինչվի յերեք աւրն՝ լինի շունչն տաք, և հետ երեք աւուրն պաղ լինի շունչն ու այլընդլի, ու խփի աչվին ու խիստ դժար շարժի զամէն զաւդվածքն, ու տքալով գոզէ, և չկարէ քայլ փոխել քանձ խիստ դժար, և երբ ընկնի՝ դժար ելնէ յոտն, ու լինի, որ քրտնի անդմունքն։
